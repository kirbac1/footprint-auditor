# Variables and secrets for the Hugging Face Space (Settings → Variables and secrets).
#
# Plain variables:
EA_ENV=dev
EA_DEMO_SCANS=true
EA_VERIFICATION_DELIVERY=console
# Only /tmp is writable on a Space, and it is wiped on every restart. That is
# the right trade for a demo: no visitor's account outlives the day.
EA_DATABASE_URL=sqlite+aiosqlite:////tmp/footprint.db
EA_SCANS_PER_DAY=20
#
# Secrets (generate with: uv run python scripts/dev_env.py, then paste the
# three values as *secrets*, not variables):
# EA_JWT_SECRET=...
# EA_FIELD_ENCRYPTION_KEY=...
# EA_BLIND_INDEX_KEY=...
#
# Optional:
# EA_DONATE_URL=https://www.paypal.com/donate/?hosted_button_id=...
